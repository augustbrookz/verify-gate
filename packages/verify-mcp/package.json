{
  "name": "@xyntherium/verify-mcp",
  "version": "1.1.0",
  "description": "MCP server with one tool, verify_answer: check whether an AI-drafted answer preserved the conditions, exceptions, dates, limits and eligibility rules in the supplied sources. Stdio; the hosted server is https://mcp.xyntherium.com/mcp.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "xyntherium-verify-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run --root ../.. --config packages/verify-mcp/vitest.config.mjs"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/augustbrookz/verify-gate.git",
    "directory": "packages/verify-mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://xyntherium.com/developers",
  "bugs": {
    "url": "https://github.com/augustbrookz/verify-gate/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "mcpName": "com.xyntherium/verify",
  "keywords": [
    "claude",
    "grounding",
    "hallucination",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "rag",
    "verification"
  ],
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.4.3"
  }
}
