{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": { "@xyntherium/verify-core": ["../verify-core/dist/index.d.ts"] }
  },
  "include": ["src"]
}
