{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": [
      "ES2021",
      "DOM"
    ],
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@xyntherium/verify-core": [
        "../verify-core/dist/index.d.ts"
      ],
      "@xyntherium/verify-parity": [
        "../verify-parity/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
